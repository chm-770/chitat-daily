rules_version = '2';
// Each signed-in user can read and write only their own data:
//   users/{uid}                 settings, city, personal psalms
//   users/{uid}/progress/{date} study progress of one day
//   dedications/{id}            dedications shown to everyone; written only by the manager
//   dedicationRequests/{id}     dedication requests from users; read only by the manager
//   reminders/{uid}             reminder times of one device (anonymous sign-in), read by the worker
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'chitatdaily@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function shortString(v, max) {
      return v is string && v.size() <= max;
    }
    match /dedications/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /dedicationRequests/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(
          ['type', 'duration', 'text', 'startDate', 'donor', 'amount', 'email', 'lang', 'createdAt'])
        && request.resource.data.type in ['ilui', 'refua', 'hatzlacha', 'zivug', 'zchut', 'parnasa', 'other']
        && request.resource.data.duration in ['day', 'week', 'month']
        && shortString(request.resource.data.text, 200) && request.resource.data.text.size() > 0
        && shortString(request.resource.data.startDate, 10)
        && shortString(request.resource.data.donor, 100)
        && request.resource.data.amount is int && request.resource.data.amount >= 25 && request.resource.data.amount <= 100000
        && shortString(request.resource.data.email, 200)
        && shortString(request.resource.data.lang, 2);
    }
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /progress/{date} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
    match /reminders/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
