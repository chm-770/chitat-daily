    "postinstall": "node -e \"const fs=require('fs');['node_modules/vite/dist/client/client.mjs','node_modules/vite/dist/client/bundledDevClient.mjs'].forEach(f=>{if(fs.existsSync(f)){let c=fs.readFileSync(f,'utf8');if(c.includes('ws.send(JSON.stringify(data));')){c=c.replaceAll('ws.send(JSON.stringify(data));','if (ws && ws.readyState === ws.OPEN) ws.send(JSON.stringify(data));');fs.writeFileSync(f,c,'utf8');}}});\""
  },
